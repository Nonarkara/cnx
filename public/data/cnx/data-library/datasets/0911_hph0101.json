{"id":"a3f35e72-e8f5-4a2e-a7e8-7a387507d96f","name":"0911_hph0101","title":"สถิติผู้รับบริการโรงพยาบาลส่งเสริมสุขภาพ ศูนย์อนามัยที่ 1 เชียงใหม่","notes":"-สถิติผู้รับบริการ หมายถึง สถิติผู้รับบริการที่มารับบริการที่โรงพยาบาลส่งเสริมสุขภาพ ศูนย์อนามัยที่ 1 เชียงใหม่\r\n-โรงพยาบาลส่งเสริมสุขภาพเชียงใหม่ หมายถึง สถานพยาบาลที่เป็นโรงพยาบาลสาธิตของศูนย์อนามัยที่ 1 เชียงใหม่\r\n-ข้อมูลชุดนี้ เป็นชุดข้อมูลสถิติผู้รับบริการโรงพยาบาลส่งเสริมสุขภาพ ศูนย์อนามัยที่ 1 เชียงใหม่ จัดเก็บจากข้อมูลระเบียนในระบบสารสนเทศของคลีนิคต่างๆ มุ่งประโยชน์ในการจัดทำเป็นสถิติ ใช้สำหรับการสรุป วิเคราะห์ วางแผน ในการดำเนินงานของคลีนิค และของโรงพยาบาลส่งเสริมสุขภาพ ศูนย์อนามัยที่ 1 เชียงใหม่ รวมทั้งเพื่อให้ประชาชน นักวิชาการที่สนใจ สามารถนำไปใช้ประโยชน์ต่อไป\r\n","org":"กรมอนามัย","domain":"health","tags":["สถิติผู้รับบริการ","โรงพยาบาลส่งเสริมสุขภาพเชียงใหม่"],"license":"Open Data Common","accessCondition":"ไม่มี","dataSource":"จากข้อมูลระเบียนในระบบสารสนเทศของคลีนิคต่างๆ ของโรงพยาบาลส่งเสริมสุขภาพเชียงใหม่","maintainer":"กลุ่มขับเคลื่อนยุทธศาสตร์และพัฒนากำลังคน ","firstYear":"2566","lastYear":"2567","created":"2024-07-12T07:45:59.527499","modified":"2026-05-25T08:45:37.314317","portalUrl":"https://data.go.th/dataset/0911_hph0101","tables":[{"resourceId":"57f62714-4d05-4a92-a37b-7a25942b2c71","name":"สถิติผู้รับบริการโรงพยาบาลส่งเสริมสุขภาพ ศูนย์อนามัยที่ 1 เชียงใหม่","format":"CSV","sourceUrl":"https://datacatalog.anamai.moph.go.th/dataset/a3f35e72-e8f5-4a2e-a7e8-7a387507d96f/resource/57f62714-4d05-4a92-a37b-7a25942b2c71/download/0911_hph0101.csv","size":16032,"columns":[{"name":"id","kind":"number"},{"name":"hoscode","kind":"text"},{"name":"mem_id","kind":"number"},{"name":"d_update","kind":"time"},{"name":"ym_update","kind":"time"},{"name":"b_year","kind":"time"},{"name":"token","kind":"text"},{"name":"A1H","kind":"number"},{"name":"A1V","kind":"number"},{"name":"A2H","kind":"number"},{"name":"A2V","kind":"number"},{"name":"A3H","kind":"number"},{"name":"A3V","kind":"number"},{"name":"A4H","ki