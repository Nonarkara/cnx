{
  "name": "cnx-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PROVINCE": "cnx",
    "SITE_URL": "https://cnx.nonarkara.org"
  },
  "routes": [
    { "pattern": "api/cnx/*", "zone_name": "nonarkara.org", "custom_domain": true }
  ]
}
