# Copy to relay-flights.env (gitignored) — never commit real values.

# Shared secret with the Worker's CNX_FLIGHTS_RELAY_SECRET. Generate with:
#   openssl rand -hex 32
CNX_FLIGHTS_RELAY_SECRET=

# Optional: a free OpenSky account (opensky-network.org) raises the poll
# budget beyond adsb.lol's shared-IP rate limit if that starts failing too.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional official YouTube Data API key: daily recent Chiang Mai coverage.
# Restrict the key to YouTube Data API v3 in its Google Cloud project.
# No key: the coverage panel honestly reports unavailable; no searches run.
CNX_YOUTUBE_API_KEY=
