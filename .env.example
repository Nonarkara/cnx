# ─── CNX War Room — Environment Variables ───────────────────────────────────
#
# Copy this file to `.env.local` for `npm run dev` (Next.js).
# Use `.dev.vars` only for Wrangler local Worker development, or
# inject the same names into the Cloudflare Worker via
# `wrangler secret put NAME` for sensitive values, or `vars` in
# wrangler.cnx.jsonc for non-sensitive build-time values.
#
# Anything prefixed NEXT_PUBLIC_* is inlined into the JS bundle at build
# time. None of those are secrets — they're public site URLs and Git
# commit metadata.
#
# Non-NEXT_PUBLIC values are server-side configuration; some are secrets,
# while paths and feature switches are not. Next.js reads .env.local;
# a deployed Worker needs its own variables/secrets.
#
# ─── Build-time (inlined into the bundle) ─────────────────────────────────

NEXT_PUBLIC_PROVINCE=cnx
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Build provenance — set automatically by `npm run build:cnx`. Override
# only if you build outside the npm script.
# NEXT_PUBLIC_GIT_SHA=
# NEXT_PUBLIC_GIT_BRANCH=
# NEXT_PUBLIC_BUILD_TIME=


# ─── Server-only secrets ───────────────────────────────────────────────────

# NASA FIRMS — fire hotspot map-key. Without this the FIRMS /api/cnx/fires
# endpoint returns an empty array (anonymous mode is rate-limited), and
# /api/cnx/smoke-trajectory reports provenance="unavailable" because it
# only advects a real VIIRS pass.
# Sign up at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=

# ─── No key needed ─────────────────────────────────────────────────────────
#
# CMU CCDC DustBoy (src/lib/cnx/dustboy.ts) is a KEYLESS public feed —
# www-old.cmuccdc.org/assets/api/haze/pwa/json/stations.json. There is no
# DUSTBOY_TOKEN and adding one does nothing; the ~400-station feed answers
# without credentials. (The newer open-api.cmuccdc.org does need a token,
# but its /api/ccdc/stations listing exposes caretakers' names and phone
# numbers, so this project deliberately does not use it.)
#
# ASMC (src/lib/cnx/asmc.ts) has no working public host. Set BOTH of these
# only if you obtain credentials from asmc.asean.org; the module makes no
# request unless both are present, because the previously-defaulted host
# api.haze.asean.org does not resolve.
# ASMC_API_KEY=
# ASMC_BASE=

# OpenSky Network — flight state API. The anonymous tier (no creds) works
# but is rate-limited; with creds the limit jumps to 4,000 req/day.
# Sign up at https://opensky-network.org/apidoc/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional override for live HII/ThaiWater flood telemetry. Set to "0"
# to force the SCENARIO fallback (Chiang Mai Ping river + Mae Ngat dam)
# even when the public API is reachable — useful for testing the offline
# path. Defaults to live.
# CNX_FLOOD_LIVE=1

# Optional local snapshot output. The modules otherwise try an operator's
# /Volumes/Data path before falling back to process memory. These portable
# paths keep fresh-clone output within this project and are gitignored.
# Cloudflare Worker storage/KV is configured separately; process memory
# is not durable storage.
CNX_FLIGHT_SNAPSHOT_DIR=.data/cnx/flights
CNX_ARRIVALS_SNAPSHOT_DIR=.data/cnx/arrivals
CNX_VISITORS_SNAPSHOT_DIR=.data/cnx/visitors
